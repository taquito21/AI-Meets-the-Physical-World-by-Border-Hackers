# Copy to backend/.env and fill in. Never commit .env or put keys in the web client.
# Format is KEY=value (an equals sign, not a colon). Restart the server after changes.
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic        # or "none" to disable AI assessment
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low                # low | medium | high (latency vs depth)
# AI_TIMEOUT_S=60
# AI_FALLBACKS=true            # server-side refusal fallback (beta)
# TRANSLATE_MODEL=claude-haiku-5-5   # translates typed text and AI reviews into the other language
# TRANSLATE_TIMEOUT_S=15        # 8 on Vercel, so a photo upload fits in the 60 s limit
# APP_LABEL=FieldSight         # interface label
# BLOCK_SUBMIT_ON_OPEN_CRITICAL=false

# Data: Postgres + photo storage on Supabase, reached over HTTPS (REST API). Without these, the app uses local
# SQLite + files in backend/data. Apply backend/supabase/schema.sql once in the Supabase SQL editor first.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...   # server side only; the secret key must never reach the web client
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # public: given to the web client for login
# VOYAGE_API_KEY=                      # document search (MongoDB Atlas -> AI Model APIs)
# STORAGE_BUCKET=files
# DATA_BACKEND=local                  # force local storage even when the Supabase keys are set
# SUPABASE_JWKS_URL=...              # optional; defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
