# Copy to backend/.env and fill in. Never commit .env or put keys in the web client.
# Format is KEY=value (an equals sign, not a colon). Restart the server after changes.
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic        # or "none" to disable AI assessment
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low                # low | medium | high (latency vs depth)
# AI_TIMEOUT_S=60
# AI_FALLBACKS=true            # server-side refusal fallback (beta)
# APP_LABEL=Field Assistant    # interface label; product name is not final
# BLOCK_SUBMIT_ON_OPEN_CRITICAL=false

# Supabase (server side only; the secret key must never reach the web client)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# STORAGE_BUCKET=evidence
